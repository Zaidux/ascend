<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme keeps the app free of the Material Components dependency.
         Compose owns all real theming; this only prevents a white flash on launch. -->
    <style name="Theme.Ascend" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
